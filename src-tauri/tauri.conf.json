{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnemosys",
  "version": "0.1.0",
  "identifier": "com.mnemosys.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./node_modules/.bin/tsc && ./node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mnemosys",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Education",
    "shortDescription": "Next-gen spaced repetition desktop app",
    "longDescription": "Mnemosys is a fast, beautiful, FSRS-powered spaced repetition app built with Tauri 2 and React 19."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.mnemosys.app/{{target}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
